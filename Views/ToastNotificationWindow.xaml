<Window x:Class="NvidiaCi.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="370"
        Height="112"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True">
    <Border x:Name="ToastBorder"
            Margin="4"
            Padding="16"
            Background="#EF111111"
            BorderBrush="#78FFFFFF"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusBadge"
                    Width="34"
                    Height="34"
                    VerticalAlignment="Top"
                    Background="#3BFFFFFF"
                    CornerRadius="17">
                <TextBlock x:Name="StatusGlyph"
                           Text="✓"
                           Foreground="#FFFFFFFF"
                           FontSize="17"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                <TextBlock x:Name="ToastTitle"
                           Foreground="#FFF5F5F5"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ToastMessage"
                           Margin="0,5,0,0"
                           Foreground="#FFB8B8B8"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="38"/>
            </StackPanel>
            <Button Grid.Column="2"
                    Width="26"
                    Height="26"
                    Padding="0"
                    Content="×"
                    Foreground="#FFFFFFFF"
                    Background="#28FFFFFF"
                    BorderThickness="0"
                    FontSize="17"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
